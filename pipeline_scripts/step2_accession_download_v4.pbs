#!/bin/bash
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -J 1-288%20
#PBS -j oe
#PBS -o logs/

ml tools/prod
ml Python

cd $PBS_O_WORKDIR

eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate ncbi_download

mkdir -p ncbi_cli logs

ACC=$(sed -n "${PBS_ARRAY_INDEX}p" genera_ncbi_ids.txt)

# Guard: empty accession
if [[ -z "$ACC" ]]; then
    echo "No accession for index ${PBS_ARRAY_INDEX}. Exiting."
    exit 0
fi

for attempt in 1 2 3; do
    datasets download genome taxon "$ACC" --reference \
        --assembly-level complete,chromosome \
        --filename ncbi_cli/${ACC}.zip && break
    echo "Attempt ${attempt} failed for ${ACC}, retrying..."
    sleep 30
done
