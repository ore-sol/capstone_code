#!/bin/bash
#PBS -l walltime=55:00:00
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -j oe
#PBS -o logs/

cd $PBS_O_WORKDIR

eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate gapseq

mkdir -p logs
mkdir -p "$PBS_O_WORKDIR/gapseq_output"

SCRIPT_START=$(date +%s)
PROGRESS_LOG="$PBS_O_WORKDIR/logs/progress.log"
LOCK_FILE="$PBS_O_WORKDIR/logs/progress.lock"
: > "$PROGRESS_LOG"

fmt_time() {
    local t=$1
    printf '%02d:%02d:%02d' $((t/3600)) $((t%3600/60)) $((t%60))
}
export -f fmt_time

log_msg() {
    local msg="$1"
    local elapsed
    elapsed=$(( $(date +%s) - SCRIPT_START ))
    (
        flock -x 200
        echo "[elapsed $(fmt_time "$elapsed")] $msg" | tee -a "$PROGRESS_LOG"
    ) 200>"$LOCK_FILE"
}
export -f log_msg
export SCRIPT_START PROGRESS_LOG LOCK_FILE

run_gapseq() {
    local INFILE=$1
    local BASENAME=$(basename "$INFILE" .fna)
    local GENOME_START=$(date +%s)

    log_msg "[RUN] gapseq on: $BASENAME"

    cd "$PBS_O_WORKDIR/gapseq_output" || exit 1
    gapseq find -p all -b 12 "$INFILE"
    gapseq find-transport -b 12 "$INFILE"
    gapseq draft \
        -r "${BASENAME}-all-Reactions.tbl" \
        -t "${BASENAME}-Transporter.tbl" \
        -p "${BASENAME}-all-Pathways.tbl" \


    local GENOME_TIME=$(( $(date +%s) - GENOME_START ))
    log_msg "[DONE] $BASENAME - finished in $(fmt_time $GENOME_TIME)"
}

export -f run_gapseq

find "$PBS_O_WORKDIR/mash/results/best_genomes" -name "*.fna" | \
    xargs -P 12 -I {} bash -c 'run_gapseq "$@"' _ {}

find "$PBS_O_WORKDIR/gapseq_output" -name "*-draft.xml" | sort > "$PBS_O_WORKDIR/draft_list.txt"
log_msg "[INFO] draft_list.txt generated with $(wc -l < "$PBS_O_WORKDIR/draft_list.txt") entries"
